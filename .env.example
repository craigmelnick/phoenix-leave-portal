# Copy this file to .env and fill in real values before going live.

# Set to "production" once deployed for real — this disables the dev-mode OTP fallback
# (which would otherwise print/return login codes instead of emailing them).
NODE_ENV=development

# Port the app listens on.
PORT=3000

# Where the SQLite database file lives. The default (./data/leave.db) is fine for most
# deployments — just make sure that folder is on a persistent disk, not a temp/ephemeral one.
DB_PATH=./data/leave.db

# --- Email (for the one-time login code) ---
# Use the SMTP details for the company's existing email provider (e.g. Google Workspace,
# Microsoft 365, or whoever hosts @phoenixintl.co.za mailboxes), or a transactional email
# service like Postmark, SendGrid or Mailgun if preferred. Without these set, the app falls
# back to logging the code to the server console (and returning it in the API response) —
# fine for testing, but it will refuse to do that once NODE_ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Phoenix Leave Portal <no-reply@phoenixintl.co.za>"
